---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { CONTRIBUTIONS, DISTRIBUTION, SKILLS, STATS, BOOKS, PROJECTS } from '../data/site';

const sections = [
  { id: 'heat', label: '热力' },
  { id: 'dist', label: '分布' },
  { id: 'skill', label: '能力' },
  { id: 'log', label: '日志' },
];

// 月份标签：每 4~5 周一个，落在网格列上
const monthLabels = [
  { at: 2, label: '12月' },
  { at: 6, label: '1月' },
  { at: 11, label: '2月' },
  { at: 15, label: '3月' },
  { at: 20, label: '4月' },
  { at: 24, label: '5月' },
  { at: 28, label: '6月' },
  { at: 33, label: '7月' },
  { at: 37, label: '8月' },
  { at: 41, label: '9月' },
  { at: 46, label: '10月' },
  { at: 50, label: '11月' },
];

const dayNames = ['一', '', '三', '', '五', '', '日'];

const weekly = CONTRIBUTIONS.map((col) => col.reduce((a, b) => a + b, 0));
const maxWeekly = Math.max(...weekly);
const w = 900;
const h = 130;
const points = weekly
  .map((v, i) => {
    const x = (i / (weekly.length - 1)) * w;
    const y = h - (v / maxWeekly) * (h - 12) - 6;
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  })
  .join(' ');
const areaPath = `M0,${h} L${points.replaceAll(' ', ' L')} L${w},${h} Z`;

const total = CONTRIBUTIONS.flat().reduce((a, b) => a + b, 0);
const activeDays = CONTRIBUTIONS.flat().filter((v) => v > 0).length;
const distMax = Math.max(...DISTRIBUTION.map((d) => d.num));
---

<BaseLayout title="遥测" description="站点运行遥测：热力、分布与能力曲线。" sections={sections} index="TELEMETRY-02">
  <header class="page-head">
    <div>
      <p class="page-head__index">02 / TELEMETRY</p>
      <h1>遥测<span>TELEMETRY</span></h1>
      <p class="page-head__desc">
        一台机器是否健康，不需要形容词。这里只有读数：热量如何分布，时间如何被消耗，能力曲线落在哪一格。
      </p>
    </div>
    <div class="page-head__aside">
      <b>观测周期 W{STATS.weeks}</b>
      采样 06:00 · 每日<br />
      数据源 GitHub / 本地日志<br />
      延迟 约 4 分钟
    </div>
  </header>

  <section class="section" id="heat">
    <div class="section__head reveal">
      <h2 class="section__title">贡献热力<em>CONTRIBUTION HEAT · 53 WEEKS</em></h2>
      <p class="section__aside">
        总热量 <span class="mono" style="color:var(--brass-hi)">{total}</span> 单位<br />
        有火的日子 {activeDays} / {CONTRIBUTIONS.length * 7}<br />
        峰值 {maxWeekly} 单位 / 周
      </p>
    </div>

    <div class="heat reveal">
      <div class="heat__months" aria-hidden="true">
        {monthLabels.map((m) => <span style={`grid-column:${m.at + 1} / span 4`}>{m.label}</span>)}
      </div>
      <div class="heat__body">
        <div class="heat__days" aria-hidden="true">
          {dayNames.map((d) => <span>{d}</span>)}
        </div>
        <div class="heat__grid" role="img" aria-label="过去 53 周的贡献热力网格">
          {
            CONTRIBUTIONS.map((col, wi) =>
              col.map((v, di) => (
                <span
                  class="heat__cell"
                  data-v={v}
                  title={`第 ${wi + 1} 周 · 周${['一', '二', '三', '四', '五', '六', '日'][di]} · ${v ? `${v} 单位热量` : '无记录'}`}
                />
              )),
            )
          }
        </div>
      </div>
      <div class="heat__legend">
        <span>冷</span>
        <i class="heat__cell" data-v="0"></i>
        <i class="heat__cell" data-v="1"></i>
        <i class="heat__cell" data-v="2"></i>
        <i class="heat__cell" data-v="3"></i>
        <i class="heat__cell" data-v="4"></i>
        <span>热</span>
      </div>
    </div>

    <div class="plate reveal" style="margin-top:clamp(26px,3.4vw,44px)">
      <div class="plate__body">
        <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:12px">
          <p class="kicker">热流曲线 / WEEKLY OUTPUT</p>
          <p class="mono" style="font-size:9px;letter-spacing:.16em;color:var(--text-faint)">单位：热量当量</p>
        </div>
        <svg viewBox={`0 0 ${w} ${h}`} style="width:100%;height:auto;margin-top:18px" aria-hidden="true">
          <defs>
            <linearGradient id="spark" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#d96b27" stop-opacity="0.5" />
              <stop offset="1" stop-color="#d96b27" stop-opacity="0" />
            </linearGradient>
          </defs>
          <path d={areaPath} fill="url(#spark)" />
          <polyline points={points} fill="none" stroke="#d97a33" stroke-width="1.6" stroke-linejoin="round" />
          <polyline points={points} fill="none" stroke="#e8c34a" stroke-width="0.6" opacity="0.5" />
          <g stroke="rgba(165,196,212,0.12)" stroke-width="1">
            <line x1="0" y1={h * 0.25} x2={w} y2={h * 0.25} />
            <line x1="0" y1={h * 0.5} x2={w} y2={h * 0.5} />
            <line x1="0" y1={h * 0.75} x2={w} y2={h * 0.75} />
          </g>
        </svg>
      </div>
    </div>
  </section>

  <section class="section" id="dist">
    <div class="section__head reveal">
      <h2 class="section__title">热量分布<em>DISTRIBUTION · ALT VIEW</em></h2>
      <p class="section__aside">
        按 Tab 分配 · 六大类<br />
        按住 ALT 显示经济分布<br />
        单位：百分比份额
      </p>
    </div>

    <div class="split">
      <div class="reveal">
        <div class="dist">
          {
            DISTRIBUTION.map((d) => (
              <div class="dist__row" title={`${d.label} · ${d.metric}`}>
                <span class="dist__num">{d.num}</span>
                <span class="dist__label">
                  {d.label}
                  <em>{d.en}</em>
                </span>
                <span class="dist__bar">
                  <i style={`width:${Math.round((d.num / distMax) * 100)}%`} />
                </span>
              </div>
            ))
          }
        </div>
        <p class="mono" style="margin-top:16px;font-size:9px;letter-spacing:.14em;color:var(--text-faint)">
          注：份额为示意值，接真实数据后由构建脚本注入。
        </p>
      </div>

      <div class="reveal" data-delay="1">
        <div class="plate">
          <div class="plate__body">
            <p class="kicker">读数 / READOUT</p>
            <div class="grid-2" style="margin-top:18px">
              <div class="stat" style="border:0;padding:0;background:none">
                <p class="stat__label">提交</p>
                <p class="stat__value">{STATS.commits.toLocaleString()}</p>
              </div>
              <div class="stat" style="border:0;padding:0;background:none">
                <p class="stat__label">仓库</p>
                <p class="stat__value">{STATS.repos}</p>
              </div>
              <div class="stat" style="border:0;padding:0;background:none">
                <p class="stat__label">已上线条目</p>
                <p class="stat__value">{PROJECTS.filter((p) => p.open).length}</p>
              </div>
              <div class="stat" style="border:0;padding:0;background:none">
                <p class="stat__label">在读</p>
                <p class="stat__value">{BOOKS.filter((b) => b.status === '在读').length}</p>
              </div>
            </div>
            <hr class="rule" style="margin:22px 0" />
            <p class="lead" style="font-size:14px">
              供热优先级：先保证“可维护”，再保证“好看”。这条规则写在每一块面板的背面。
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="skill">
    <div class="section__head reveal">
      <h2 class="section__title">能力矩阵<em>CAPABILITY GRID</em></h2>
      <p class="section__aside">自评 · 非绝对刻度<br />每年校准一次</p>
    </div>

    <div class="grid-2 reveal">
      {
        SKILLS.map((s) => (
          <div class="skill">
            <div class="skill__top">
              <span class="skill__name">{s.name}</span>
              <span class="skill__val mono">{s.value}</span>
            </div>
            <div class="meter">
              <i class="meter__fill" style={`width:${s.value}%`} />
            </div>
            <p class="skill__note">{s.note}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section" id="log">
    <div class="section__head reveal">
      <h2 class="section__title">运行日志<em>OPERATION LOG</em></h2>
      <p class="section__aside">最近 6 条 · 已脱敏</p>
    </div>

    <div class="plate reveal">
      <div class="plate__body" style="padding:0">
        <div class="log">
          {
            [
              ['06:12', 'GENERATOR', '点火完成，压力 0.98，进入稳态运行。', 'ok'],
              ['06:00', 'TELEMETRY', '采样本周热力：峰值出现在周三。', 'ok'],
              ['03:41', 'FOUNDRY', '研究树节点「供暖网格」升到 2 级。', 'ok'],
              ['01:18', 'ARCHIVE', '新增一条阅读笔记：《设计中的设计》。', 'ok'],
              ['22:07', 'WARNING', '外部温度骤降至 -34°C，已提高过载阈值。', 'warn'],
              ['21:44', 'ACOUSTIC', '曲目切换：The City Must Survive。', 'ok'],
            ].map(([time, tag, msg, level]) => (
              <div class="log__row">
                <span class="log__time">{time}</span>
                <span class={`log__tag ${level === 'warn' ? 'is-warn' : ''}`}>{tag}</span>
                <span class="log__msg">{msg}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <p class="mono reveal" style="margin-top:18px;font-size:9px;letter-spacing:.14em;color:var(--text-faint)">
      <Icon name="terminal" size={11} /> 日志由构建脚本生成；接真实数据后替换为 CI 输出。
    </p>
  </section>
</BaseLayout>

<style>
  .skill {
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }

  .skill__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }

  .skill__name {
    font-family: var(--font-serif);
    font-size: 14px;
    letter-spacing: 0.14em;
    color: var(--text-strong);
  }

  .skill__val {
    font-size: 11px;
    color: var(--brass-hi);
  }

  .skill__note {
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    color: var(--text-faint);
  }

  .log {
    display: grid;
  }

  .log__row {
    display: grid;
    grid-template-columns: 60px 96px 1fr;
    gap: 14px;
    align-items: baseline;
    padding: 13px 22px;
    border-bottom: 1px solid var(--line);
  }

  .log__row:last-child {
    border-bottom: 0;
  }

  .log__time {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-faint);
  }

  .log__tag {
    font-family: var(--font-mono);
    font-size: 8.5px;
    letter-spacing: 0.14em;
    color: var(--brass);
  }

  .log__tag.is-warn {
    color: var(--alert);
  }

  .log__msg {
    font-size: 12.5px;
    line-height: 1.8;
    color: var(--text-dim);
  }

  @media (max-width: 620px) {
    .log__row {
      grid-template-columns: 52px 1fr;
    }
    .log__msg {
      grid-column: 1 / -1;
    }
  }
</style>
