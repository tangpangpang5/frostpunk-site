---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sheets from '../components/Sheets.astro';
import Icon from '../components/Icon.astro';
import { BOOKS, ARCHIVE_TABS, TIMELINE, PROJECTS } from '../data/site';

const sections = [
  { id: 'ledger', label: '档案' },
  { id: 'notes', label: '笔记' },
  { id: 'queue', label: '队列' },
  { id: 'chronicle', label: '编年' },
];

const read = BOOKS.filter((b) => b.status === '已读' || b.status === '在读');
const queued = BOOKS.filter((b) => b.status === '待读');

const notes = [
  {
    id: 'n1',
    title: '复杂度的两个来源',
    source: '《代码大全》· 第 5 章',
    date: '2026-10-28',
    tag: '工程',
    body: '本质复杂度无法消除，偶然复杂度可以。大部分重构不是在优化性能，而是在把偶然复杂度搬回它该在的地方。',
  },
  {
    id: 'n2',
    title: '白霜不是白色',
    source: 'Frostpunk 2 艺术设定集',
    date: '2026-10-11',
    tag: '视觉',
    body: '1920 的白霜其实由三种灰构成：纸的暖灰、霜的冷灰、以及被雪反射的天光。纯白会让所有界面同时失焦。',
  },
  {
    id: 'n3',
    title: '状态机比 if 更诚实',
    source: '内部技术评审 · 2026-09',
    date: '2026-09-19',
    tag: '架构',
    body: '当一段逻辑出现第三个布尔量时，它已经不是逻辑，而是一张状态图。把它画出来，比给它加注释便宜。',
  },
  {
    id: 'n4',
    title: '切角的代价',
    source: '设计系统周会',
    date: '2026-08-30',
    tag: '视觉',
    body: 'clip-path 切角会裁掉焦点环与阴影溢出。凡是用切角的容器，必须自己补一层 1px 内描边，否则它在高对比模式下会消失。',
  },
  {
    id: 'n5',
    title: '把动效当作计量单位',
    source: '《设计中的设计》· 笔记',
    date: '2026-08-02',
    tag: '设计',
    body: '300ms 不是一个审美数字，它是“动作被感知为因果”的上限。超过它，用户开始怀疑点击是否生效。',
  },
];
---

<BaseLayout title="档案" description="阅读记录、笔记与编年史。" sections={sections} index="ARCHIVE-03">
  <header class="page-head">
    <div>
      <p class="page-head__index">03 / ARCHIVE</p>
      <h1>档案<span>THE ARCHIVE</span></h1>
      <p class="page-head__desc">
        一座城市的历史由两类东西构成：被写下来的法律，和没有被写下来的习惯。这里存放前者。
      </p>
    </div>
    <div class="page-head__aside">
      <b>共 {BOOKS.length + notes.length} 条记录</b>
      阅读 {read.length} · 队列 {queued.length}<br />
      笔记 {notes.length} · 编年 {TIMELINE.length}<br />
      最近更新 2026-11-12
    </div>
  </header>

  <div class="clipping reveal" style="margin-top:clamp(26px,3.4vw,44px)">
    <p class="clipping__tag">编者按 · EDITORIAL</p>
    <p class="clipping__quote">
      “我们不是在保存过去，我们是在为下一次寒潮准备证词。”
    </p>
    <p class="clipping__by">新伦敦档案局 · 第 241 周 · 抄本第 7 号</p>
  </div>

  <section class="section" id="ledger" style="padding-top:clamp(34px,4vw,56px)">
    <div class="tabs archive__tabs" role="tablist" aria-label="档案分类" data-tabs="archive-panels">
      {
        ARCHIVE_TABS.map((tab, i) => (
          <button
            class="tab"
            type="button"
            role="tab"
            id={`tab-${tab.key}`}
            data-tab={tab.key}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`panel-${tab.key}`}
          >
            {tab.label}
          </button>
        ))
      }
    </div>

    <div id="archive-panels">
      <!-- 生存：阅读记录 -->
      <div class="archive__panel" data-panel="read" id="panel-read" role="tabpanel" aria-labelledby="tab-read">
        <div class="archive__grid">
          <div>
            <p class="archive__col-title">已读与在读 <span>LEDGER</span></p>
            <div class="lawlist">
              {
                read.map((b) => (
                  <button
                    class="lawrow"
                    type="button"
                    data-book
                    data-title={b.title}
                    data-author={b.author}
                    data-status={b.status}
                    data-quote={b.quote}
                    data-notes={String(b.notes)}
                    data-rating={String(b.rating)}
                    data-category={b.category}
                    data-progress={String('progress' in b ? b.progress : b.status === '已读' ? 100 : 0)}
                  >
                    <span class="lawrow__glyph">§</span>
                    <span>
                      <span class="lawrow__title">
                        {b.title} <em style="font-style:normal;font-weight:400;color:var(--text-faint);font-size:12px">· {b.author}</em>
                      </span>
                      <span class="lawrow__meta">
                        <span>{b.category}</span>
                        <span>·</span>
                        <span>{b.status}</span>
                        <span>·</span>
                        <span>{b.notes} 条笔记</span>
                      </span>
                    </span>
                    <span class="lawrow__slots">
                      {[0, 1, 2, 3, 4].map((i) => <i class={`slot ${i < b.rating ? 'slot--diamond slot--on' : 'slot--diamond'}`} />)}
                    </span>
                  </button>
                ))
              }
            </div>
          </div>

          <div>
            <p class="archive__col-title">阅读规则 <span>RULES</span></p>
            <div class="archive__note">
              <b>一、</b>读不完的书不留在架上，移到队列。<br />
              <b>二、</b>每本书至少写一条能独立成立的笔记。<br />
              <b>三、</b>技术书的笔记必须能被一年后的自己执行。<br />
              <b>四、</b>小说不记笔记，只记引文。
            </div>
            <div class="archive__stats">
              <div class="archive__stat"><span>今年读完</span><b>14</b></div>
              <div class="archive__stat"><span>今年开始</span><b>21</b></div>
              <div class="archive__stat"><span>平均页数</span><b>342</b></div>
              <div class="archive__stat"><span>最长一本</span><b>1,104 页</b></div>
              <div class="archive__stat"><span>笔记总数</span><b>94</b></div>
            </div>
          </div>
        </div>
      </div>

      <!-- 城市：笔记 -->
      <div class="archive__panel" data-panel="reading" id="panel-reading" role="tabpanel" aria-labelledby="tab-reading" hidden>
        <div class="archive__grid" style="grid-template-columns:repeat(auto-fit,minmax(300px,1fr))">
          {
            notes.map((n) => (
              <article class="note" id={`note-${n.id}`}>
                <p class="note__tag">
                  <span>{n.tag}</span>
                  <span class="mono">{n.date}</span>
                </p>
                <h3 class="note__title">§ {n.title}</h3>
                <p class="note__body">{n.body}</p>
                <p class="note__src">— {n.source}</p>
              </article>
            ))
          }
        </div>
      </div>

      <!-- 社会：队列 -->
      <div class="archive__panel" data-panel="stack" id="panel-stack" role="tabpanel" aria-labelledby="tab-stack" hidden>
        <div class="archive__grid">
          <div>
            <p class="archive__col-title">待读队列 <span>QUEUE</span></p>
            <div class="lawlist">
              {
                queued.map((b, i) => (
                  <div class="lawrow" style="cursor:default">
                    <span class="lawrow__glyph">{String(i + 1).padStart(2, '0')}</span>
                    <span>
                      <span class="lawrow__title">{b.title}</span>
                      <span class="lawrow__meta">
                        <span>{b.author}</span>
                        <span>·</span>
                        <span>{b.category}</span>
                      </span>
                    </span>
                    <span class="lawrow__slots">
                      <i class="slot slot--diamond" />
                      <i class="slot slot--diamond" />
                    </span>
                  </div>
                ))
              }
            </div>
            <p class="mono" style="margin-top:14px;font-size:9px;letter-spacing:.12em;color:var(--text-faint)">
              队列按“能否在一个供暖周期内读完”排序。
            </p>
          </div>

          <div>
            <p class="archive__col-title">技术债台账 <span>DEBT</span></p>
            <div class="dist">
              {
                [
                  ['01', '双纪元切换缺少 View Transitions 回退', '已排期'],
                  ['02', '声学页音频文件待接入', '阻塞'],
                  ['03', '研究树移动端退化为列表', '可接受'],
                  ['04', '热力图为静态生成，未接 API', '已排期'],
                  ['05', 'RSS 只输出最近 10 条', '可接受'],
                ].map(([n, name, state]) => (
                  <div class="dist__row">
                    <span class="dist__num">{n}</span>
                    <span class="dist__label">{name}</span>
                    <span class={`chip ${state === '阻塞' ? 'chip--warm' : ''}`}>{state}</span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <!-- 统治：编年 -->
      <div class="archive__panel" data-panel="all" id="panel-all" role="tabpanel" aria-labelledby="tab-all" hidden>
        <div class="split">
          <div>
            <p class="archive__col-title">编年 <span>CHRONICLE</span></p>
            <div class="timeline">
              {
                TIMELINE.map((item) => (
                  <div class="timeline__item">
                    <span class="timeline__year">{item.year}</span>
                    <p class="timeline__text">{item.text}</p>
                  </div>
                ))
              }
            </div>
          </div>
          <div>
            <p class="archive__col-title">已归档工程 <span>SHIPPED</span></p>
            <div class="dist">
              {
                PROJECTS.map((p, i) => (
                  <div class="dist__row">
                    <span class="dist__num">{String(i + 1).padStart(2, '0')}</span>
                    <span class="dist__label">
                      {p.name}
                      <em>{p.year}</em>
                    </span>
                    <span class={`chip ${p.open ? 'chip--live' : ''}`}>{p.open ? '在线' : '封存'}</span>
                  </div>
                ))
              }
            </div>
            <div class="archive__stats" style="margin-top:22px">
              <div class="archive__stat"><span>档案体积</span><b>2.4 MB</b></div>
              <div class="archive__stat"><span>最深一层</span><b>3 级</b></div>
              <div class="archive__stat"><span>最后校对</span><b>2026-11-12</b></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="notes">
    <div class="section__head reveal">
      <h2 class="section__title">引用<em>COMMONPLACE BOOK</em></h2>
      <p class="section__aside">摘录 · 不做解释</p>
    </div>
    <div class="grid-2 reveal">
      {
        [
          ['“寒冷不是敌人，低估它才是。”', '极地生存手册'],
          ['“设计不是创造新奇，而是重新发现日常。”', '原研哉'],
          ['“软件构建的本质是管理复杂度。”', 'Steve McConnell'],
          ['“唯一比寒冷更持久的东西，是习惯。”', '厄休拉·勒古恩'],
        ].map(([quote, by]) => (
          <blockquote class="quote">
            <p>{quote}</p>
            <cite>— {by}</cite>
          </blockquote>
        ))
      }
    </div>
  </section>

  <Sheets />
</BaseLayout>

<style>
  .note {
    position: relative;
    padding: 22px 24px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg-1) 50%, transparent);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 16px), calc(100% - 16px) 100%, 0 100%);
  }

  .note__tag {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 8.5px;
    letter-spacing: 0.16em;
    color: var(--text-faint);
    text-transform: uppercase;
  }

  .note__tag span:first-child {
    color: var(--brass);
  }

  .note__title {
    margin-top: 12px;
    font-family: var(--font-serif);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-strong);
    line-height: 1.5;
  }

  .note__body {
    margin-top: 10px;
    font-size: 13px;
    line-height: 1.95;
    color: var(--text-dim);
  }

  .note__src {
    margin-top: 14px;
    padding-top: 10px;
    border-top: 1px dotted var(--line-mid);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    color: var(--text-faint);
  }

  .quote {
    position: relative;
    padding: 20px 24px 20px 30px;
    border-left: 2px solid var(--brass);
    background: linear-gradient(90deg, color-mix(in srgb, var(--brass) 8%, transparent), transparent);
  }

  .quote p {
    font-family: var(--font-serif);
    font-size: clamp(15px, 1.5vw, 19px);
    line-height: 1.8;
    letter-spacing: 0.04em;
    color: var(--text);
  }

  .quote cite {
    display: block;
    margin-top: 10px;
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 9px;
    letter-spacing: 0.16em;
    color: var(--text-faint);
  }

  .lawrow em {
    font-family: var(--font-serif);
  }
</style>
