---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sheets from '../components/Sheets.astro';
import Icon from '../components/Icon.astro';
import { PROJECTS, SKILLS } from '../data/site';

const sections = [
  { id: 'tree', label: '研究树' },
  { id: 'workshop', label: '工坊' },
  { id: 'shipped', label: '产出' },
  { id: 'method', label: '工艺' },
];

type Node = { id: string; x: number; y: number; label: string; tier: string; level: string; hours: number; core?: boolean };

const nodes: Node[] = [
  { id: 'core', x: 50, y: 52, label: '工程核心', tier: 'CORE', level: 'III', hours: 0, core: true },
  { id: 'heat', x: 50, y: 22, label: '渲染管线', tier: '供热', level: 'IV', hours: 1420 },
  { id: 'grid', x: 26, y: 30, label: '布局系统', tier: '供热', level: 'IV', hours: 980 },
  { id: 'motion', x: 74, y: 30, label: '动效系统', tier: '供热', level: 'III', hours: 760 },
  { id: 'token', x: 18, y: 56, label: '设计令牌', tier: '资源', level: 'V', hours: 640 },
  { id: 'a11y', x: 82, y: 56, label: '无障碍', tier: '资源', level: 'III', hours: 410 },
  { id: 'build', x: 32, y: 72, label: '构建流水线', tier: '霜地', level: 'IV', hours: 880 },
  { id: 'edge', x: 68, y: 72, label: '边缘运行时', tier: '霜地', level: 'II', hours: 320 },
  { id: 'obs', x: 22, y: 82, label: '可观测性', tier: '社会', level: 'III', hours: 260 },
  { id: 'dx', x: 50, y: 84, label: '开发体验', tier: '社会', level: 'III', hours: 520 },
  { id: 'doc', x: 78, y: 82, label: '文档系统', tier: '社会', level: 'II', hours: 180 },
];

const links = [
  ['core', 'heat'], ['core', 'grid'], ['core', 'motion'],
  ['grid', 'token'], ['motion', 'a11y'], ['heat', 'motion'],
  ['grid', 'build'], ['motion', 'edge'], ['build', 'dx'],
  ['token', 'obs'], ['a11y', 'doc'], ['build', 'obs'], ['edge', 'doc'],
];

const byId = Object.fromEntries(nodes.map((n) => [n.id, n]));
---

<BaseLayout title="熔炉" description="研究树、工坊与已交付的工程。" sections={sections} index="FOUNDRY-04">
  <header class="page-head">
    <div>
      <p class="page-head__index">04 / FOUNDRY</p>
      <h1>熔炉<span>THE FOUNDRY</span></h1>
      <p class="page-head__desc">
        技术不是被发明的，是被锻造出来的。每一次升级都要消耗燃料：时间、失败、以及一两个不眠夜。
      </p>
    </div>
    <div class="page-head__aside">
      <b>研究速度 143%</b>
      已解锁 {nodes.length} 个节点<br />
      累计投入 {(nodes.reduce((a, b) => a + b.hours, 0) / 1000).toFixed(1)}k 小时<br />
      进行中 1 项
    </div>
  </header>

  <section class="section" id="tree">
    <div class="section__head reveal">
      <h2 class="section__title">研究树<em>RESEARCH TREE</em></h2>
      <p class="section__aside">
        按 ALT 查看资源流向<br />
        金色裂缝 = 已打通路径
      </p>
    </div>

    <div class="plate reveal">
      <div class="plate__body" style="padding:0">
        <div class="tree">
          <svg class="tree__cracks" viewBox="0 0 1000 640" preserveAspectRatio="none" aria-hidden="true">
            {links.map(([a, b]) => {
              const from = byId[a];
              const to = byId[b];
              return (
                <line
                  x1={(from.x / 100) * 1000}
                  y1={(from.y / 100) * 640}
                  x2={(to.x / 100) * 1000}
                  y2={(to.y / 100) * 640}
                  stroke="url(#crack)"
                  stroke-width="1.4"
                />
              );
            })}
            <defs>
              <linearGradient id="crack" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#a8792f" stop-opacity="0.85" />
                <stop offset="0.5" stop-color="#e0b45a" stop-opacity="0.35" />
                <stop offset="1" stop-color="#a8792f" stop-opacity="0.1" />
              </linearGradient>
            </defs>
          </svg>

          <div class="tree__smoke" aria-hidden="true"></div>

          {
            nodes.map((n) => (
              <button
                class={`tree__node ${n.core ? 'tree__node--core' : ''}`}
                type="button"
                style={`--x:${n.x}%;--y:${n.y}%`}
                title={`${n.label} · ${n.tier} · ${n.hours ? `${n.hours} 小时` : '枢纽'}`}
                aria-label={`${n.label}，${n.tier}，Lv.${n.level}`}
              >
                {n.core ? (
                  <span class="tree__core">
                    <Icon name="cog" size={42} />
                  </span>
                ) : (
                  <span class="tree__icon">
                    <Icon
                      name={n.tier === '供热' ? 'flame' : n.tier === '资源' ? 'layers' : n.tier === '霜地' ? 'snow' : 'compass'}
                      size={13}
                    />
                  </span>
                )}
                <span class="tree__name">{n.label}</span>
                <span class="tree__en">
                  {n.tier} · LV.{n.level}
                </span>
              </button>
            ))
          }

          <div class="tree__badge">
            <Icon name="flame" size={11} /> 研究速度 143% · 研究中「边缘运行时」34%
          </div>

          <div class="tree__legend" aria-hidden="true">
            <span><i></i>已解锁</span>
            <span><i class="dim"></i>研究中</span>
            <span>金色裂缝 = 已打通的路径</span>
          </div>
        </div>
      </div>
    </div>

    <div class="tree-list">
      {
        nodes.map((n) => (
          <div class="lawrow" style="cursor:default">
            <span class="lawrow__glyph">{n.core ? '◆' : '◇'}</span>
            <span>
              <span class="lawrow__title">{n.label}</span>
              <span class="lawrow__meta">
                <span>{n.tier}</span>
                <span>·</span>
                <span>Lv.{n.level}</span>
                <span>·</span>
                <span>{n.hours ? `${n.hours} h` : '枢纽'}</span>
              </span>
            </span>
            <span class="chip">{n.core ? '核心' : '已解锁'}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section" id="workshop">
    <div class="section__head reveal">
      <h2 class="section__title">工坊面板<em>WORKSHOP PANEL</em></h2>
      <p class="section__aside">效率实时 · 可切换过载</p>
    </div>

    <div class="split" data-overdrive="off">
      <div class="plate reveal" id="workshop">
        <div class="plate__body" style="padding:0">
          <div class="plaque" style="justify-content:center">
            <span>效率</span>
            <b class="plaque__num" data-eff>126%</b>
          </div>

          <div class="workshop">
            <div class="thermo" aria-hidden="true">
              <span class="thermo__cap"></span>
              <span class="thermo__tube"><i class="thermo__fill"></i></span>
              <span class="thermo__cap"></span>
            </div>

            <div class="workshop__stage">
              <div class="workshop__visual" aria-hidden="true">
                <svg class="workshop__skyline" viewBox="0 0 320 132" preserveAspectRatio="none" aria-hidden="true">
                  <g fill="#05080a">
                    <path d="M0 132V92h10V70h7v22h13v40zM44 132V100h9V80h6v20h12v32z" />
                    <path d="M248 132V86h11V62h7v24h14v46zM296 132V98h9V76h7v22h8v34z" />
                    <path d="M110 132v-16h20v16zM190 132v-22h18v22z" />
                  </g>
                </svg>
                <span class="workshop__glow"></span>
                <span class="workshop__gear workshop__gear--a"></span>
                <span class="workshop__gear workshop__gear--b"></span>
                <span class="workshop__sparks"></span>
              </div>
              <h3>高级制钢 · 前端产线</h3>
              <p>
                三班倒的构建队列：静态输出在左，交互水合在右，中间是永远差 2% 的压缩率。
              </p>
              <div class="workshop__actions">
                <button class="wbtn" type="button" data-wbtn="boost">
                  <Icon name="bolt" size={18} />
                  <span>加压</span>
                </button>
                <button class="wbtn" type="button" data-wbtn="cycle">
                  <Icon name="cog" size={18} />
                  <span>重启产线</span>
                </button>
                <button class="wbtn" type="button" data-wbtn="halt">
                  <Icon name="snow" size={18} />
                  <span>停机</span>
                </button>
              </div>
            </div>

            <div class="capsules">
              <label class="capsule">
                <span>产线</span>
                <input type="checkbox" checked data-capsule="line" />
                <i></i>
              </label>
              <label class="capsule">
                <span>过载</span>
                <input type="checkbox" data-capsule="overload" />
                <i></i>
              </label>
              <label class="capsule">
                <span>检修</span>
                <input type="checkbox" data-capsule="service" />
                <i></i>
              </label>
            </div>
          </div>

          <div class="workshop__foot">
            <span class="mono">燃料 · 时间 / 电力 / 咖啡</span>
            <span class="mono" data-wstatus>状态：稳态运行</span>
          </div>
        </div>
      </div>

      <div class="reveal" data-delay="1">
        <p class="archive__col-title">产能读数 <span>OUTPUT</span></p>
        <div class="dist">
          {
            [
              ['01', '构建时长', '42s'],
              ['02', '首屏字节', '18.4 KB'],
              ['03', 'Lighthouse 性能', '98'],
              ['04', '可访问性', '100'],
              ['05', '测试覆盖', '81%'],
            ].map(([n, name, val]) => (
              <div class="dist__row">
                <span class="dist__num">{n}</span>
                <span class="dist__label">{name}</span>
                <span class="mono" style="color:var(--brass-hi);font-size:11px">{val}</span>
              </div>
            ))
          }
        </div>
        <p class="lead" style="margin-top:22px;font-size:14px">
          过载不是常态。它是一次被记录的例外——所以这里允许你把它打开，也允许它自己关掉。
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="shipped">
    <div class="section__head reveal">
      <h2 class="section__title">已交付<em>SHIPPED WORKS</em></h2>
      <p class="section__aside">按交付年份倒序</p>
    </div>

    <div class="grid-3 reveal">
      {
        PROJECTS.map((p) => (
          <article class="wcard">
            <div class="wcard__top">
              <span class="wcard__year mono">{p.year}</span>
              <span class={`chip ${p.open ? 'chip--live' : ''}`}>{p.open ? '在线' : '封存'}</span>
            </div>
            <h3 class="wcard__title">{p.name}</h3>
            <p class="wcard__desc">{p.desc}</p>
            <div class="wcard__tags">
              {p.stack.map((t) => <span class="chip">{t}</span>)}
            </div>
            <button class="wcard__more" type="button" data-project data-name={p.name} data-year={p.year} data-desc={p.desc} data-detail={p.metric ? `${p.metric.label} ${p.metric.value}` : p.desc} data-stack={p.stack.join(' / ')} data-link={p.link}>
              查看图纸 <Icon name="arrow" size={13} />
            </button>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section" id="method">
    <div class="section__head reveal">
      <h2 class="section__title">工艺规程<em>PROCESS</em></h2>
      <p class="section__aside">写进手册的四条 · 不写第五条</p>
    </div>

    <div class="grid-2 reveal">
      {
        [
          ['01', '先立骨架', '内容结构定稿之前不写组件。结构错了，再漂亮的组件也是废铁。'],
          ['02', '再谈温度', '动效只回答一个问题：发生了什么。回答不了就删掉。'],
          ['03', '留出余量', '每个模块预留 20% 的“不明需求”空间——寒潮总会来。'],
          ['04', '可拆可弃', '任何一块面板都应该能单独拆下来，交给下一个人继续烧。'],
        ].map(([n, title, body]) => (
          <div class="method">
            <span class="method__num mono">{n}</span>
            <div>
              <h3>{title}</h3>
              <p>{body}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="plate reveal" style="margin-top:clamp(26px,3.4vw,44px)">
      <div class="plate__body">
        <p class="kicker">能力校准 / CALIBRATION</p>
        <div class="grid-2" style="margin-top:18px">
          {
            SKILLS.map((s) => (
              <div class="skill">
                <div class="skill__top">
                  <span class="skill__name">{s.name}</span>
                  <span class="skill__val mono">{s.value}</span>
                </div>
                <div class="meter"><i class="meter__fill" style="width:100%;opacity:.35" /></div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <Sheets />
</BaseLayout>

<style>
  .workshop {
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr) 92px;
    gap: 18px;
    align-items: stretch;
    padding: 22px;
  }

  .thermo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .thermo__cap {
    width: 14px;
    height: 6px;
    background: var(--line-mid);
  }

  .thermo__tube {
    position: relative;
    flex: 1;
    width: 16px;
    border: 1px solid var(--line-mid);
    background: color-mix(in srgb, var(--bg-0) 70%, transparent);
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  .thermo__fill {
    display: block;
    width: 100%;
    height: 62%;
    background: linear-gradient(180deg, #e8394a, #a3162a);
    box-shadow: 0 0 14px rgba(230, 57, 70, 0.55);
    transition: height 0.6s var(--ease-mech);
  }

  [data-overdrive='on'] .thermo__fill {
    height: 88%;
  }

  .workshop__stage h3 {
    font-family: var(--font-display);
    font-size: clamp(18px, 2vw, 26px);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-strong);
  }

  .workshop__stage p {
    margin-top: 8px;
    max-width: 46ch;
    font-size: 12.5px;
    line-height: 1.9;
    color: var(--text-dim);
  }

  .workshop__visual {
    position: relative;
    height: 132px;
    margin-bottom: 16px;
    border: 1px solid var(--line);
    overflow: hidden;
    background:
      radial-gradient(60% 80% at 50% 110%, rgba(217, 107, 39, 0.5), transparent 70%),
      linear-gradient(180deg, #0a0d10, #14191f);
  }

  .workshop__glow {
    position: absolute;
    left: 50%;
    bottom: -34px;
    width: 60%;
    height: 80px;
    transform: translateX(-50%);
    background: #d96b27;
    filter: blur(30px);
    opacity: 0.75;
  }

  .workshop__gear {
    position: absolute;
    border: 6px dashed rgba(165, 196, 212, 0.28);
    border-radius: 50%;
    animation: spin 18s linear infinite;
  }

  .workshop__gear--a {
    width: 74px;
    height: 74px;
    left: 26%;
    top: 26px;
  }

  .workshop__gear--b {
    width: 44px;
    height: 44px;
    left: 52%;
    top: 58px;
    animation-direction: reverse;
    animation-duration: 12s;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .workshop__sparks {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, #e8c34a 1px, transparent 1.4px);
    background-size: 26px 26px;
    opacity: 0.18;
    mix-blend-mode: screen;
  }

  [data-overdrive='on'] .workshop__visual {
    box-shadow: inset 0 0 40px rgba(230, 57, 70, 0.35);
  }

  [data-overdrive='on'] .workshop__glow {
    background: #e63946;
    opacity: 1;
  }

  .workshop__actions {
    display: flex;
    gap: 10px;
    margin-top: 18px;
    flex-wrap: wrap;
  }

  .wbtn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid var(--line-mid);
    background: color-mix(in srgb, var(--bg-2) 70%, transparent);
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition: 0.16s;
  }

  .wbtn:hover {
    color: var(--brass-hi);
    border-color: var(--brass);
  }

  .wbtn.is-active {
    border-color: var(--brass);
    color: #12161a;
    background: var(--brass-hi);
  }

  .capsules {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;
    justify-content: center;
  }

  .capsule {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 7px;
    cursor: pointer;
  }

  .capsule > span {
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.2em;
    color: var(--text-faint);
    transition: color var(--t-fast);
  }

  .capsule input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .capsule i {
    position: relative;
    display: block;
    width: 18px;
    height: 40px;
    border: 1px solid var(--line-mid);
    background: #05080a;
    transition: border-color var(--t-fast), box-shadow var(--t-fast);
  }

  .capsule i::after {
    content: '';
    position: absolute;
    left: 2px;
    right: 2px;
    top: 2px;
    height: 14px;
    background: linear-gradient(180deg, #f0f4f5, #a9bcc3);
    transition: top var(--t-mid) var(--ease-mech), background var(--t-mid);
  }

  .capsule input:checked + i::after {
    top: 22px;
    background: linear-gradient(180deg, #e8c67a, #8c6239);
    box-shadow: 0 0 10px rgba(217, 164, 65, 0.5);
  }

  .capsule input:checked ~ span,
  .capsule:hover > span {
    color: var(--brass-hi);
  }

  .capsule input:focus-visible + i {
    outline: 1px solid var(--brass-hi);
    outline-offset: 2px;
  }

  .workshop__skyline {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.85;
  }

  .workshop__foot {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 22px;
    border-top: 1px solid var(--line);
    font-size: 9px;
    letter-spacing: 0.12em;
    color: var(--text-faint);
  }

  .method {
    display: grid;
    grid-template-columns: 46px 1fr;
    gap: 16px;
    padding: 20px 0;
    border-top: 1px solid var(--line);
  }

  .method__num {
    font-size: 22px;
    color: var(--brass);
    opacity: 0.6;
  }

  .method h3 {
    font-family: var(--font-serif);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--text-strong);
  }

  .method p {
    margin-top: 8px;
    font-size: 13px;
    line-height: 1.9;
    color: var(--text-dim);
  }

  @media (max-width: 780px) {
    .workshop {
      grid-template-columns: 34px minmax(0, 1fr);
    }
    .capsules {
      grid-column: 1 / -1;
      flex-direction: row;
      gap: 26px;
    }
  }
</style>
