---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { PLAYLIST } from '../data/site';

const sections = [
  { id: 'map', label: '航路' },
  { id: 'player', label: '留声机' },
  { id: 'mix', label: '混音' },
  { id: 'slot', label: '音槽' },
];

const route = PLAYLIST.map((p) => `${p.x},${p.y}`).join(' ');
const first = PLAYLIST[0];
---

<BaseLayout title="声学" description="航路、留声机与环境混音。" sections={sections} index="ACOUSTIC-05">
  <header class="page-head">
    <div>
      <p class="page-head__index">05 / ACOUSTIC</p>
      <h1>声学<span>ACOUSTIC</span></h1>
      <p class="page-head__desc">
        在零下三十度，声音传播得比平时更远。这里是航路上的六个站点，每一站对应一首在放的曲子。
      </p>
    </div>
    <div class="page-head__aside">
      <b>{PLAYLIST.length} 个站点</b>
      航路总长 1,284 km<br />
      当前曲目 {first.track}<br />
      播放器 待接入音频
    </div>
  </header>

  <section class="section" id="map">
    <div class="section__head reveal">
      <h2 class="section__title">冻原航路<em>FROSTLAND ROUTE</em></h2>
      <p class="section__aside">点击站点切换曲目<br />虚线 = 已勘测 · 实线 = 正在行进</p>
    </div>

    <div class="frostmap reveal">
      <span class="frostmap__texture" aria-hidden="true"></span>
      <span class="frostmap__grid" aria-hidden="true"></span>

      <svg class="frostmap__svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <polyline class="frostmap__route" points={route} vector-effect="non-scaling-stroke" />
        <polyline class="frostmap__route-live" points={route} vector-effect="non-scaling-stroke" />
      </svg>

      {
        PLAYLIST.map((p, i) => (
          <button
            class={`waypoint ${i === 0 ? 'is-active' : ''}`}
            type="button"
            style={`--x:${p.x}%;--y:${p.y}%`}
            data-track
            data-title={p.track}
            data-artist={p.artist}
            data-mood={`${p.mood} · ${p.bpm} BPM`}
            data-len={p.len}
            aria-label={`播放 ${p.track}`}
          >
            <span class="waypoint__dot" aria-hidden="true"></span>
            <span class="waypoint__label">{p.name}</span>
            <span class="waypoint__en">{p.en}</span>
          </button>
        ))
      }

      <div class="frostmap__compass" aria-hidden="true"><span>N</span></div>
      <div class="frostmap__scale" aria-hidden="true">比例 1:240 000 · 等温线 -30°C</div>
    </div>
  </section>

  <section class="section" id="player">
    <div class="section__head reveal">
      <h2 class="section__title">留声机<em>THE PHONOGRAPH</em></h2>
      <p class="section__aside">机械转速 · 无随机推荐</p>
    </div>

    <div class="split">
      <div class="plate reveal" id="player">
        <div class="plate__body">
          <div class="phonograph">
            <div class="disc" aria-hidden="true">
              <span class="disc__shine"></span>
              <span class="disc__label">N.L.<br />RECORDS</span>
              <span class="disc__arm"></span>
            </div>

            <div class="player">
              <div class="player__meta">
                <small>NOW SPINNING · 07 号唱片</small>
                <p class="player__title" data-f="title">{first.track}</p>
                <p class="player__artist" data-f="artist">{first.artist}</p>
              </div>
              <div class="player__wave" aria-hidden="true">
                {
                  Array.from({ length: 48 }).map((_, i) => (
                    <i style={`--h:${(24 + Math.abs(Math.sin(i * 1.7)) * 76).toFixed(0)}%;--i:${i}`} />
                  ))
                }
              </div>
              <audio id="ost" preload="none"></audio>
              <div class="player__controls">
                <button class="btn btn--ghost btn--icon" type="button" aria-label="上一首">
                  <Icon name="prev" size={14} />
                </button>
                <button class="btn btn--solid btn--icon" type="button" data-play aria-pressed="false" aria-label="播放或暂停">
                  <Icon name="play" size={14} />
                </button>
                <button class="btn btn--ghost btn--icon" type="button" aria-label="下一首">
                  <Icon name="next" size={14} />
                </button>
                <span class="player__time" data-f="len">{first.len}</span>
                <span class="player__scrub" aria-hidden="true"><i style="--p:18%" /></span>
              </div>
              <p class="player__note">
                <span data-f="mood">{first.mood} · {first.bpm} BPM</span><br />
                音频文件待接入：将 mp3 放入 <code>public/audio/</code>，在 <code>site.ts</code> 中填写 <code>{'{{audio_url}}'}</code>。
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="reveal" data-delay="1">
        <p class="archive__col-title">曲目表 <span>PLAYLIST</span></p>
        <div class="playlist">
          {
            PLAYLIST.map((p, i) => (
              <div
                class={`playlist__row ${i === 0 ? 'is-active' : ''}`}
                data-track
                data-title={p.track}
                data-artist={p.artist}
                data-mood={`${p.mood} · ${p.bpm} BPM`}
                data-len={p.len}
                data-src={p.src ?? ''}
                role="button"
                tabindex="0"
              >
                <span class="playlist__idx">{String(i + 1).padStart(2, '0')}</span>
                <span class="playlist__name">
                  {p.track}
                  <em>{p.name}</em>
                </span>
                <span class="playlist__mood">{p.mood}</span>
                <span class="playlist__mood mono">{p.len}</span>
              </div>
            ))
          }
        </div>
        <p class="mono" style="margin-top:14px;font-size:9px;letter-spacing:.12em;color:var(--text-faint)">
          曲目信息为演示内容，仅作版式占位。
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="mix">
    <div class="section__head reveal">
      <h2 class="section__title">环境混音<em>AMBIENT MIX</em></h2>
      <p class="section__aside">
        已启用 <span data-mix-count>2</span> / 3 声部<br />
        HUD 右上按钮控制总开关
      </p>
    </div>

    <div class="mix reveal">
      {
        [
          ['ember', '炉火', 'EMBER', '55 Hz 正弦 + 布朗噪声', true],
          ['wind', '风雪', 'WIND', '高通噪声 · 缓慢包络', true],
          ['gear', '齿轮', 'GEAR', '82.4 Hz 三角波 · 12 拍', false],
        ].map(([key, label, en, desc, on]) => (
          <label class="mix__item">
            <span class="mix__label">
              {label}
              <em>{en}</em>
            </span>
            <span class="mix__desc">{desc}</span>
            <span class="capsule">
              <span class="sr-only">{label} 声部</span>
              <input type="checkbox" data-mix={String(key)} checked={Boolean(on)} />
              <i></i>
            </span>
          </label>
        ))
      }
    </div>

    <p class="lead reveal" style="margin-top:22px;font-size:14px">
      混音由 WebAudio 实时合成，没有音频文件；这是为了让你在打开页面的第一秒就听见炉子。
    </p>
  </section>

  <section class="section" id="slot">
    <div class="section__head reveal">
      <h2 class="section__title">音槽<em>AUDIO SLOT</em></h2>
      <p class="section__aside">等待真实文件 · 占位不假装</p>
    </div>

    <div class="plate reveal">
      <div class="plate__body">
        <div class="slot-line">
          <span class="chip chip--warm">待接入</span>
          <p>
            目前所有“播放”动作只驱动界面状态。若要接入真实音频：把 mp3 放进
            <code>public/audio/</code>，然后在 <code>src/data/site.ts</code> 的
            <code>PLAYLIST</code> 里补上 <code>{'{{audio_url}}'}</code> 字段。
          </p>
        </div>
        <hr class="rule" style="margin:20px 0" />
        <div class="grid-2">
          <div>
            <p class="kicker">已就绪 / READY</p>
            <ul class="ticks">
              <li>留声机转盘与唱臂状态</li>
              <li>曲目表与站点联动</li>
              <li>环境音合成与总开关</li>
              <li>prefers-reduced-motion 下的静音降级</li>
            </ul>
          </div>
          <div>
            <p class="kicker">待办 / PENDING</p>
            <ul class="ticks ticks--dim">
              <li>真实 mp3 文件与授权说明</li>
              <li>音轨进度与拖动</li>
              <li>音量记忆（localStorage）</li>
              <li>移动端自动播放策略提示</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .mix {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    border: 1px solid var(--line);
  }

  .mix__item {
    display: grid;
    gap: 10px;
    padding: 20px 22px;
    border-right: 1px solid var(--line);
    cursor: pointer;
  }

  .mix__item:last-child {
    border-right: 0;
  }

  .mix__label {
    font-family: var(--font-serif);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--text-strong);
  }

  .mix__label em {
    display: block;
    margin-top: 4px;
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 8px;
    letter-spacing: 0.24em;
    color: var(--brass);
  }

  .mix__desc {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
    color: var(--text-faint);
    line-height: 1.7;
    min-height: 30px;
  }

  .slot-line {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
    align-items: start;
  }

  .slot-line p {
    font-size: 13px;
    line-height: 2;
    color: var(--text-dim);
  }

  .slot-line code {
    padding: 1px 5px;
    background: color-mix(in srgb, var(--brass) 14%, transparent);
    color: var(--brass-hi);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .ticks {
    display: grid;
    gap: 8px;
    margin-top: 12px;
    padding-left: 0;
    list-style: none;
  }

  .ticks li {
    position: relative;
    padding-left: 18px;
    font-size: 12.5px;
    line-height: 1.8;
    color: var(--text-dim);
  }

  .ticks li::before {
    content: '◆';
    position: absolute;
    left: 0;
    color: var(--brass);
    font-size: 8px;
    top: 4px;
  }

  .ticks--dim li {
    color: var(--text-faint);
  }

  .ticks--dim li::before {
    content: '◇';
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 760px) {
    .mix__item {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }
</style>

<style is:global>
  button.waypoint {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    color: inherit;
  }

  code {
    font-family: var(--font-mono);
  }
</style>
