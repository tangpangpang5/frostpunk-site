---
/**
 * 线性图标集。全部手绘 path，无外部依赖。
 * 用法：<Icon name="gear" size={16} />
 */
interface Props {
  name:
    | 'gear'
    | 'cog'
    | 'eye'
    | 'flame'
    | 'wrench'
    | 'bolt'
    | 'snow'
    | 'sound'
    | 'mute'
    | 'menu'
    | 'close'
    | 'arrow'
    | 'external'
    | 'book'
    | 'play'
    | 'pause'
    | 'prev'
    | 'next'
    | 'github'
    | 'mail'
    | 'rss'
    | 'chevron'
    | 'diamond'
    | 'layers'
    | 'terminal'
    | 'compass'
    | 'target';
  size?: number;
  class?: string;
}

const { name, size = 16, class: cls = '' } = Astro.props;

const paths: Record<string, string> = {
  gear: `<circle cx="12" cy="12" r="3.2"/><path d="M12 2.6v2.6M12 18.8v2.6M21.4 12h-2.6M5.2 12H2.6M18.6 5.4l-1.9 1.9M7.3 16.7l-1.9 1.9M18.6 18.6l-1.9-1.9M7.3 7.3L5.4 5.4"/>`,
  cog: `<circle cx="12" cy="12" r="7.4"/><circle cx="12" cy="12" r="2.6"/><path d="M12 4.6v1.8M12 17.6v1.8M19.4 12h-1.8M6.4 12H4.6"/>`,
  eye: `<path d="M2.4 12s3.4-5.6 9.6-5.6S21.6 12 21.6 12s-3.4 5.6-9.6 5.6S2.4 12 2.4 12Z"/><circle cx="12" cy="12" r="2.6"/>`,
  flame: `<path d="M12 21.4c3.6 0 6.2-2.3 6.2-5.6 0-4.3-4-6-4-9.9-2 1.1-3.2 3-3.2 5 0 1.4.7 2.3.7 3.3 0 1.2-.9 2-2 2-1.4 0-2.4-1.3-2.4-2.9-.9 1.2-1.5 2.7-1.5 4.4 0 3.4 2.6 5.7 6.2 5.7Z"/>`,
  wrench: `<path d="M14.7 6.3a3.9 3.9 0 0 0 5 5L12 19a2.8 2.8 0 1 1-4-4l7.7-7.7Z"/><path d="M14.7 6.3 17 4"/>`,
  bolt: `<path d="M13.4 2.6 5.2 13.4h5.6L9.8 21.4l8.2-10.8h-5.6l1-8Z"/>`,
  snow: `<path d="M12 2.8v18.4M3.9 7.3l16.2 9.4M20.1 7.3 3.9 16.7"/><path d="M9.4 4.6 12 7.2l2.6-2.6M9.4 19.4 12 16.8l2.6 2.6"/>`,
  sound: `<path d="M4.2 9.4h3l4-3.2v11.6l-4-3.2h-3z"/><path d="M15.4 9.2a3.6 3.6 0 0 1 0 5.6M17.9 6.6a7.2 7.2 0 0 1 0 10.8"/>`,
  mute: `<path d="M4.2 9.4h3l4-3.2v11.6l-4-3.2h-3z"/><path d="m15.4 9.6 5 4.8M20.4 9.6l-5 4.8"/>`,
  menu: `<path d="M3.6 7h16.8M3.6 12h16.8M3.6 17h16.8"/>`,
  close: `<path d="M5.6 5.6l12.8 12.8M18.4 5.6 5.6 18.4"/>`,
  arrow: `<path d="M4.2 12h15.2M14 6.4 20 12l-6 5.6"/>`,
  external: `<path d="M13.6 4.4H19.6v6M19.6 4.4 11 13M9.2 5.2H5.4v13.4h13.4v-3.8"/>`,
  book: `<path d="M3.6 5.2c2.6-1 5.6-1 8.4.6 2.8-1.6 5.8-1.6 8.4-.6v13.2c-2.6-1-5.6-1-8.4.6-2.8-1.6-5.8-1.6-8.4-.6z"/><path d="M12 5.8v13.2"/>`,
  play: `<path d="M7.4 4.8 19 12 7.4 19.2z"/>`,
  pause: `<path d="M8.4 5v14M15.6 5v14"/>`,
  prev: `<path d="M18 5.4 8.4 12 18 18.6zM6 5v14"/>`,
  next: `<path d="M6 5.4 15.6 12 6 18.6zM18 5v14"/>`,
  github: `<path d="M9.2 20.4c-4 .8-4-2-5.6-2.4m11.2 4v-3.4c0-1 .1-1.4-.5-2 2.8-.3 5.3-1.4 5.3-5.8a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6 0C6.3 3.7 5.2 4 5.2 4a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 3.8 10.4c0 4.3 2.5 5.5 5.3 5.8-.5.5-.6 1.1-.5 2v3.5"/>`,
  mail: `<rect x="3.4" y="5.6" width="17.2" height="12.8"/><path d="m3.8 6.4 8.2 6.4 8.2-6.4"/>`,
  rss: `<path d="M5 19a0 0 0 0 0 0 0"/><path d="M4.6 10.6a8.8 8.8 0 0 1 8.8 8.8M4.6 5.4a14 14 0 0 1 14 14"/><circle cx="5.4" cy="18.6" r="1.4"/>`,
  chevron: `<path d="m8.4 4.8 7.2 7.2-7.2 7.2"/>`,
  diamond: `<path d="M12 3.2 20.8 12 12 20.8 3.2 12z"/>`,
  layers: `<path d="m12 3.4 8.6 4.6L12 12.6 3.4 8z"/><path d="m3.4 12.4 8.6 4.6 8.6-4.6M3.4 16.6 12 21.2l8.6-4.6"/>`,
  terminal: `<rect x="3" y="4.4" width="18" height="15.2"/><path d="m7.4 9.6 2.8 2.8-2.8 2.8M12.6 15.4h4.2"/>`,
  compass: `<circle cx="12" cy="12" r="9"/><path d="m15.8 8.2-2.2 5.4-5.4 2.2 2.2-5.4z"/>`,
  target: `<circle cx="12" cy="12" r="8.6"/><circle cx="12" cy="12" r="4.6"/><circle cx="12" cy="12" r="0.9"/>`,
};

const body = paths[name] ?? paths.diamond;
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.35"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
  focusable="false"
  set:html={body}
/>
