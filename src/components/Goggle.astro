---
/**
 * 护目镜：首页主视觉。全部由 SVG 绘制，镜片里是一座正在燃烧的城市。
 * 无位图依赖，随主题切换而调色。
 */
---

<div class="hero__goggle">
  <svg class="goggle__svg" viewBox="0 0 420 420" role="img" aria-label="护目镜观测窗：镜片内是一座燃烧的城市">
    <defs>
      <linearGradient id="g-metal" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#3a454c" />
        <stop offset="0.35" stop-color="#1b2328" />
        <stop offset="0.7" stop-color="#0b1013" />
        <stop offset="1" stop-color="#2c353a" />
      </linearGradient>

      <linearGradient id="g-brass" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#c9a227" />
        <stop offset="0.45" stop-color="#6b4a22" />
        <stop offset="1" stop-color="#d9b459" />
      </linearGradient>

      <radialGradient id="g-lens" cx="0.42" cy="0.32" r="0.75">
        <stop offset="0" stop-color="#7d8f99" />
        <stop offset="0.42" stop-color="#3d4a52" />
        <stop offset="0.78" stop-color="#161d21" />
        <stop offset="1" stop-color="#080c0e" />
      </radialGradient>

      <radialGradient id="g-ember" cx="0.5" cy="0.62" r="0.55">
        <stop offset="0" stop-color="#ffb066" stop-opacity="0.95" />
        <stop offset="0.4" stop-color="#d96b27" stop-opacity="0.7" />
        <stop offset="0.72" stop-color="#8f2f12" stop-opacity="0.35" />
        <stop offset="1" stop-color="#8f2f12" stop-opacity="0" />
      </radialGradient>

      <radialGradient id="g-vig" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0.55" stop-color="#000" stop-opacity="0" />
        <stop offset="0.88" stop-color="#000" stop-opacity="0.55" />
        <stop offset="1" stop-color="#000" stop-opacity="0.92" />
      </radialGradient>

      <linearGradient id="g-sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#c9d6dc" />
        <stop offset="0.55" stop-color="#6d7f88" />
        <stop offset="1" stop-color="#232c31" />
      </linearGradient>

      <radialGradient id="g-heat" cx="0.5" cy="0.95" r="0.85">
        <stop offset="0" stop-color="#ff9d4d" stop-opacity="0.72" />
        <stop offset="0.32" stop-color="#e2601f" stop-opacity="0.38" />
        <stop offset="0.66" stop-color="#8f2f12" stop-opacity="0.14" />
        <stop offset="1" stop-color="#8f2f12" stop-opacity="0" />
      </radialGradient>

      <filter id="g-blur" x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur stdDeviation="9" />
      </filter>
      <filter id="g-soft" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="2.2" />
      </filter>

      <clipPath id="g-clip">
        <circle cx="210" cy="210" r="131" />
      </clipPath>

      <path id="g-arc-top" d="M 78 210 A 132 132 0 0 1 342 210" fill="none" />
      <path id="g-arc-bot" d="M 92 210 A 118 118 0 0 0 328 210" fill="none" />
    </defs>

    <!-- 外层金属圈 -->
    <circle cx="210" cy="210" r="203" fill="url(#g-metal)" stroke="#05080a" stroke-width="1.2" />
    <circle cx="210" cy="210" r="194" fill="none" stroke="#4a5b64" stroke-width="0.8" opacity="0.55" />
    <circle cx="210" cy="210" r="176" fill="none" stroke="#0a0e11" stroke-width="10" />
    <circle cx="210" cy="210" r="170" fill="none" stroke="url(#g-brass)" stroke-width="1.6" opacity="0.9" />
    <circle cx="210" cy="210" r="160" fill="none" stroke="#31404a" stroke-width="0.8" stroke-dasharray="2 7" opacity="0.8" />

    <!-- 铆钉 -->
    <g fill="#596a74" stroke="#05080a" stroke-width="0.8">
      {[0, 45, 90, 135, 180, 225, 270, 315].map((deg) => {
        const r = 186;
        const rad = (deg * Math.PI) / 180;
        return <circle cx={210 + r * Math.cos(rad)} cy={210 + r * Math.sin(rad)} r="3.6" />;
      })}
    </g>

    <!-- 镜片 -->
    <g clip-path="url(#g-clip)">
      <circle cx="210" cy="210" r="131" fill="url(#g-lens)" />

      <!-- 远处天际线 -->
      <path
        d="M84 250h18v-34h10v18h14v-46h9v28h13v-14h11v34h17v-52h8v22h12v-30h9v60h16v-24h11v24h16v-40h9v18h13v-26h10v48h15v-20h12v20h16v-36h9v16h12v-22h10v42h14v-30h10v74H84z"
        fill="#0d1316"
        opacity="0.9"
      />
      <path
        d="M84 250h18v-34h10v18h14v-46h9v28h13v-14h11v34h17v-52h8v22h12v-30h9v60h16v-24h11v24h16v-40h9v18h13v-26h10v48h15v-20h12v20h16v-36h9v16h12v-22h10v42h14v-30h10v74H84z"
        fill="url(#g-sky)"
        opacity="0.22"
      />

      <!-- 炉火 -->
      <ellipse cx="210" cy="330" rx="150" ry="110" fill="url(#g-heat)" />
      <g class="goggle__fire">
        <ellipse cx="204" cy="296" rx="96" ry="58" fill="url(#g-ember)" filter="url(#g-blur)" />
        <ellipse cx="238" cy="310" rx="52" ry="36" fill="#ffb066" opacity="0.62" filter="url(#g-blur)" />
        <ellipse cx="172" cy="314" rx="38" ry="26" fill="#e8813c" opacity="0.55" filter="url(#g-blur)" />
        <path
          d="M196 300c-10-8-12-20-4-30 2 8 7 11 11 14 6-9 6-17 3-26 13 8 20 22 15 34-4 10-15 15-25 8z"
          fill="#ffcf9a"
          opacity="0.95"
        />
        <path d="M232 306c-6-5-7-14-2-21 1 6 4 8 7 10 4-6 4-12 2-18 9 6 13 16 10 24-3 7-11 10-17 5z" fill="#ffb066" opacity="0.9" />
        <path d="M176 310c-5-4-6-12-2-18 1 5 3 7 6 8 3-5 3-10 1-15 7 5 10 13 8 20-2 6-9 9-13 5z" fill="#ffcf9a" opacity="0.7" />
      </g>

      <!-- 火星 -->
      <g class="goggle__sparks" fill="#ffb877">
        {Array.from({ length: 22 }, (_, i) => {
          const x = 118 + ((i * 43.7) % 180);
          const y = 214 - ((i * 29.3) % 86);
          return <circle cx={x} cy={y} r={i % 5 === 0 ? 1.5 : 0.9} opacity={0.25 + ((i % 4) / 7)} />;
        })}
      </g>

      <!-- 烟柱 -->
      <g filter="url(#g-soft)" opacity="0.55">
        <path d="M204 280c-10-26 6-40 2-62s-14-28-8-48" stroke="#39454c" stroke-width="10" fill="none" opacity="0.6" />
        <path d="M236 286c-4-20 10-30 8-48s-10-24-6-38" stroke="#2c363c" stroke-width="8" fill="none" opacity="0.55" />
      </g>

      <!-- 雪花 -->
      <g fill="#dbe8ee" opacity="0.75">
        {Array.from({ length: 46 }, (_, i) => {
          const x = 90 + ((i * 37.3) % 240);
          const y = 92 + ((i * 61.7) % 240);
          const r = i % 4 === 0 ? 1.5 : 0.9;
          return <circle cx={x} cy={y} r={r} opacity={0.35 + ((i % 5) / 8)} />;
        })}
      </g>

      <!-- 火光在镜片内壁的反照 -->
      <circle cx="210" cy="210" r="128" fill="none" stroke="#ff9d4d" stroke-width="7" opacity="0.16" filter="url(#g-blur)" />

      <!-- 玻璃反光 -->
      <path d="M120 150c26-34 66-50 100-46-38 10-72 32-92 66z" fill="#e8f4f8" opacity="0.13" />
      <path d="M262 300c18-22 26-44 24-64 2 30-6 54-24 76z" fill="#e8f4f8" opacity="0.09" />
      <circle cx="210" cy="210" r="131" fill="url(#g-vig)" />
    </g>

    <!-- 内圈压边 -->
    <circle cx="210" cy="210" r="132" fill="none" stroke="#05080a" stroke-width="3" />
    <circle cx="210" cy="210" r="137" fill="none" stroke="#7d8f99" stroke-width="1" opacity="0.5" />

    <!-- 铭文 -->
    <text font-family="Oswald, sans-serif" font-size="9.5" letter-spacing="4.4" fill="#8ba0ab" opacity="0.85">
      <textPath href="#g-arc-top" startOffset="50%" text-anchor="middle">NEW LONDON · TERMINAL 07</textPath>
    </text>
    <text font-family="Oswald, sans-serif" font-size="8.5" letter-spacing="3.6" fill="#c9a227" opacity="0.8">
      <textPath href="#g-arc-bot" startOffset="50%" text-anchor="middle">ANNO 1886 · GENERATOR SECTOR</textPath>
    </text>
  </svg>
</div>
