---
import '@fontsource/oswald/500.css';
import '@fontsource/oswald/600.css';
import '@fontsource/oswald/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif-sc/700.css';

import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/pages-core.css';
import '../styles/pages-machines.css';
import '../styles/refine.css';

import Hud from '../components/Hud.astro';
import Rail from '../components/Rail.astro';
import Splash from '../components/Splash.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description?: string;
  sections?: { id: string; label: string }[];
  index?: string;
  sector?: string;
}

const {
  title,
  description = SITE.slogan,
  sections = [],
  index = 'CORE',
  sector = 'SECTOR 07',
} = Astro.props;

const fullTitle = `${title} · ${SITE.city}控制台`;
---

<!doctype html>
<html lang="zh-CN" data-era="1886" data-motion="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0e11" />
    <meta name="generator" content="Astro" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%230b0e11'/%3E%3Cpath d='M16 4 28 16 16 28 4 16z' fill='none' stroke='%23c9a227' stroke-width='1.5'/%3E%3Ccircle cx='16' cy='16' r='3' fill='%23d96b27'/%3E%3C/svg%3E"
    />

    <!-- 纪元与启动画面必须在首帧前决定，避免闪白 -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        let era = '1886';
        try {
          era = localStorage.getItem('nl-era') === '1920' ? '1920' : '1886';
        } catch {}
        // 深链：?era=1920 可直接分享某一纪元的视图
        const q = new URLSearchParams(location.search).get('era');
        if (q === '1886' || q === '1920') era = q;
        root.dataset.era = era;

        let seen = false;
        try {
          seen = sessionStorage.getItem('nl-splash') === '1';
        } catch {}
        if (seen || new URLSearchParams(location.search).has('nofx')) {
          root.dataset.splash = 'off';
        }

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.dataset.motion = 'reduced';
        }
      })();
    </script>

    <style>
      [data-splash='off'] #splash {
        display: none;
      }
      html {
        background: var(--bg-0);
      }
    </style>
  </head>

  <body>
    <a class="skip" href="#main">跳到主内容</a>

    <!-- 泼墨位移滤镜，供首页背景使用 -->
    <svg width="0" height="0" aria-hidden="true" style="position:absolute">
      <defs>
        <filter id="ink" x="-20%" y="-20%" width="140%" height="140%">
          <feTurbulence type="fractalNoise" baseFrequency="0.012" numOctaves="3" seed="11" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="34" xChannelSelector="R" yChannelSelector="G" />
        </filter>
      </defs>
    </svg>

    <Splash />
    <Hud />
    <Rail items={sections} sector={sector} />

    <div class="shell">
      <main id="main" class="page">
        <slot />
      </main>

      <footer class="bottom">
        <span class="bottom__status">
          <i class="bottom__led"></i>
          能量塔在线 · GENERATOR ONLINE
        </span>
        <div class="bottom__meta">
          <span>供暖效率 126%</span>
          <span>周期 W241</span>
          <a href={`mailto:${SITE.email}`}>联络</a>
          <a href={SITE.handle}>GITHUB</a>
          <a href="/rss.xml">RSS</a>
          <span>v1.0.0 · {index}</span>
        </div>
        <span>© 2026 {SITE.author} · 新伦敦 · {'{{ domain }}'}</span>
      </footer>
    </div>

    <!-- 底部固定状态轨：把视口夹成观测窗 -->
    <div class="railbar" aria-hidden="true">
      <span class="railbar__cap">GENERATOR</span>
      <span class="railbar__gauge"><i></i></span>
      <span class="railbar__val">126%</span>
      <span class="railbar__mid">NEXT CYCLE · 00:42:18</span>
      <span class="railbar__right">
        <b>-30°C</b><span>·</span><b>W241</b><span>·</span><b data-clock>--:--:--</b>
      </span>
    </div>

    <!-- 纪元切换的闸门遮罩 -->
    <div class="gate" id="gate" aria-hidden="true"><span class="gate__ring">◈</span></div>

    <div class="noise" aria-hidden="true"></div>
    <div class="vignette" aria-hidden="true"></div>
    <div class="frost" aria-hidden="true"></div>

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
